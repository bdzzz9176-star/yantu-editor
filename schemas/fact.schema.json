{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yantu-editor.local/schemas/fact.schema.json",
  "title": "研途编辑事实记录",
  "type": "object",
  "required": ["fact_id", "entity", "field", "value", "academic_year", "scope", "status", "source_refs"],
  "properties": {
    "fact_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "entity": {"type": "string", "minLength": 1},
    "field": {"type": "string", "minLength": 1},
    "value": {},
    "unit": {"type": ["string", "null"]},
    "academic_year": {"type": ["integer", "null"]},
    "scope": {"type": "object"},
    "status": {"enum": ["unverified", "verified", "conflicted", "rejected"]},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "page", "evidence"],
        "properties": {
          "source_id": {"type": "string"},
          "page": {"type": ["integer", "null"]},
          "printed_page": {"type": ["integer", "null"]},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}

